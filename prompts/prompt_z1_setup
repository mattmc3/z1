#!/usr/bin/env zsh
# prompt_z1_setup: Add a nice prompt for Z1 users.
#
# The prompt itself is one format string, so rearranging it does not mean
# rewriting anything:
#   zstyle ':z1:prompt' format '$pwd $char '
#   zstyle ':z1:prompt' right-format '$git( $timer)'
#
# lib/prompt.zsh explains what a format can hold and how to write a segment of
# your own; lib/prompt-segments.zsh has the ones used here, plus `status` and
# `timer`, which this prompt leaves out of its default shape.

# Remove right prompt from prior commands
setopt transient_rprompt

# What the prompt looks like when nothing says otherwise. A zstyle wins over
# these, so a user rearranges the prompt without touching this file.
typeset -g _prompt_z1_format='$pwd $char '
typeset -g _prompt_z1_right_format='$git'

function prompt_z1_precmd {
  setopt local_options
  unsetopt xtrace ksh_arrays

  # Re-read the transient style each time, so turning it on or off takes effect
  # from the next prompt rather than only at setup.
  if zstyle -t ':z1:prompt' transient; then
    _prompt_z1_transient="$z1_prompt_fg[cyan]$z1_prompt_char[success]%f "
    [[ "$widgets[accept-line]" == user:prompt_z1_accept_line ]] \
      || zle -N accept-line prompt_z1_accept_line
  else
    _prompt_z1_transient=
    [[ "$widgets[accept-line]" == user:prompt_z1_accept_line ]] \
      && zle -A .accept-line accept-line
  fi

  # Put the full prompt back after a line was collapsed to the character alone.
  PROMPT=$_prompt_z1_full
}

# Collapse an accepted line to just the character.
function prompt_z1_accept_line {
  PROMPT=$_prompt_z1_transient
  zle .reset-prompt
  zle .accept-line
}

function prompt_z1_setup {
  setopt local_options
  unsetopt xtrace ksh_arrays
  prompt_opts=(cr percent sp subst)

  # %x is this file even when autoloaded, so the libraries beside it are findable
  # whether z1 was cloned whole or copied one file at a time.
  0=${(%):-%x}
  local libdir=${0:A:h:h}/lib

  # vcs_info off the critical path when the library is there. The prompt works
  # without it, just synchronously.
  [[ -r $libdir/async.zsh ]] && source $libdir/async.zsh

  if [[ ! -r $libdir/prompt.zsh || ! -r $libdir/prompt-segments.zsh ]]; then
    print -ru2 "prompt_z1_setup: cannot find lib/prompt.zsh beside $libdir:h"
    return 1
  fi
  source $libdir/prompt.zsh
  source $libdir/prompt-segments.zsh

  # A style wins, otherwise this prompt's own shape.
  z1_prompt_format=$_prompt_z1_format
  z1_prompt_right_format=$_prompt_z1_right_format

  z1-prompt-build

  # An accepted line can collapse to just the character, in cyan rather than the
  # status color, so scrollback stays quiet. prompt_z1_precmd picks this up:
  #   zstyle ':z1:prompt' transient 'yes'
  typeset -g _prompt_z1_full=$PROMPT _prompt_z1_transient=

  autoload -Uz add-zsh-hook
  add-zsh-hook precmd prompt_z1_precmd

  # Hand back the hooks and the accept-line widget when another theme takes
  # over. Only there once promptinit has a theme applied, which is not the case
  # when this file is sourced on its own.
  (( $+functions[prompt_cleanup] )) && prompt_cleanup prompt_z1_cleanup
  return 0
}

function prompt_z1_cleanup {
  autoload -Uz add-zsh-hook
  add-zsh-hook -d precmd prompt_z1_precmd
  [[ "$widgets[accept-line]" == user:prompt_z1_accept_line ]] \
    && zle -A .accept-line accept-line
  (( $+functions[z1-prompt-unbuild] )) && z1-prompt-unbuild
  return 0
}

function prompt_z1_preview {
  local +h PROMPT=''
  local +h RPROMPT=''
  local +h SPROMPT=''

  prompt_preview_theme 'z1'
}

prompt_z1_setup "$@"
